---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { link } from '../lib/site';
---

<BaseLayout
  title="Page not found | Luxury Duo Cleaning LLC"
  description="The page you requested could not be found."
  noindex
>
  <Nav slot="nav" />

  <section class="mx-auto max-w-2xl px-4 py-20 sm:py-28 text-center sm:px-6">
    <p class="text-xs font-bold uppercase tracking-[0.15em] text-accent">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">Page not found</h1>
    <p class="mt-4 text-lg text-muted">The page moved or never existed.</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href={link('/')} variant="outline">Back to Home</Button>
      <Button href={link('/quote/')} variant="primary">Get a Free Quote</Button>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
