---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found | Luxury Duo Cleaning LLC" description="The page you requested could not be found.">
  <section style="padding: 8rem 1rem; text-align: center;">
    <p class="draft-pill">404</p>
    <h1 style="font-size: 2.5rem; font-weight: 800; margin: 1rem 0;">Page not found</h1>
    <p style="color: #5a6270;">The page moved or never existed.</p>
    <p style="margin-top: 1.5rem;"><a href={`${base}`} style="color: #3e7cb1; font-weight: 700;">Back to home</a></p>
  </section>
</BaseLayout>
