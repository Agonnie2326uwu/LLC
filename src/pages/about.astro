---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stat from '../components/Stat.astro';
import RoundCarousel from '../components/RoundCarousel.astro';
import CtaBand from '../components/CtaBand.astro';
import { link, PHONE_HREF } from '../lib/site';

import { Picture } from 'astro:assets';
import whyUs from '../assets/images/why-us.jpg';
import { widthSet, PICTURE_FORMATS } from '../lib/images';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="About Us | Luxury Duo Cleaning LLC Orlando FL"
  description="Learn about Luxury Duo Cleaning LLC — Orlando's precision cleaning company. Our mission, values, and commitment to quality work across Central Florida."
>
  <Nav slot="nav" />

  <PageHero
    eyebrow="About Us"
    title="Built on Precision. Driven by Results."
    lead="Luxury Duo Cleaning LLC was founded in Orlando with one goal: to become the cleaning company that contractors, businesses, and homeowners actually trust."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Our Mission</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          To give every client a space that's truly clean — on schedule, to
          spec, and without the follow-up calls. Whether it's a job site
          before handover or your home before guests arrive, you should be
          able to count on us to get it right the first time.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          That means clear quotes, crews that show up when promised, and the
          same precision and professionalism you expect from the contractors
          and businesses you already trust.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-8 rounded-xl border border-line bg-bg-alt p-10 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3" data-reveal="right">
        <Stat value="100%" label="Licensed & Insured" />
        <Stat value="Same-day" label="Quote Turnaround" />
        <Stat value="Orlando" label="Serving All Areas" />
      </div>
    </div>
  </section>

  <section class="bg-bg-alt">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <SectionHeader
        title="What Sets Us Apart"
        lead="Three principles that drive every job we take on."
      />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <article class="rounded-xl border border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md" data-reveal data-reveal-delay="0">
          <h3 class="text-xl font-bold text-ink">Efficiency</h3>
          <p class="mt-2 text-muted">We work fast without cutting corners. Contractor schedules don't wait, and neither do we. Every minute on-site is purposeful.</p>
        </article>
        <article class="rounded-xl border border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md" data-reveal data-reveal-delay="1">
          <h3 class="text-xl font-bold text-ink">Reliability</h3>
          <p class="mt-2 text-muted">We show up when we say we will. Consistent scheduling, consistent quality, consistent communication. No surprises.</p>
        </article>
        <article class="rounded-xl border border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md" data-reveal data-reveal-delay="2">
          <h3 class="text-xl font-bold text-ink">Attention to Detail</h3>
          <p class="mt-2 text-muted">We notice what others overlook. Baseboards, window tracks, grout lines — the details that make a space actually clean, not just tidy.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <SectionHeader
      title="What We Do"
      lead="Six specialized cleaning services, each built for a different kind of client."
    />
    <div class="mt-10" data-reveal>
      <RoundCarousel />
    </div>
  </section>

  <section class="bg-bg-alt">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <SectionHeader
        title="Our Story"
        lead="From a single crew to a trusted Orlando cleaning partner."
      />
      <div class="mt-10 grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <p class="text-xl font-semibold leading-relaxed text-ink sm:text-2xl">
            Luxury Duo Cleaning LLC was started with a simple belief: that
            cleaning is a service business, and service means showing up,
            doing the work right, and earning the next job.
          </p>
          <p class="mt-4 text-xl leading-relaxed text-ink">
            Based in Orlando, we started serving residential clients and
            quickly expanded into commercial and construction cleaning as
            contractors recognized the quality of our work. Today, we serve
            general contractors, property managers, Airbnb hosts, and
            homeowners across the greater Orlando area.
          </p>
          <p class="mt-4 text-xl leading-relaxed text-ink">
            We're still growing, and we're still hands-on. Every job gets the
            same attention to detail whether it's a single-family home or a
            large commercial buildout.
          </p>
        </div>
        <figure data-reveal="right" class="group overflow-hidden rounded-xl border border-line shadow-sm">
          <Picture
            src={whyUs}
            alt="Two-person Luxury Duo Cleaning crew wiping down a table in Orlando FL"
            formats={[...PICTURE_FORMATS]}
            fallbackFormat="jpg"
            widths={widthSet(whyUs, [400])}
            sizes="(min-width: 1280px) 560px, (min-width: 1024px) 45vw, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            pictureAttributes={{ class: 'contents' }}
          />
        </figure>
      </div>
    </div>
  </section>

  <CtaBand
    title="Ready for a Cleaner Space?"
    lead="Tell us about your property and we'll send a detailed estimate within hours."
    primaryHref={link('/quote/')}
    primaryLabel="Get a Free Quote"
    secondaryHref={PHONE_HREF}
    secondaryLabel="Call Now"
  />

  <Footer slot="footer" />
</BaseLayout>
