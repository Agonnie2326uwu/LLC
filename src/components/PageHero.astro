---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="bg-primary bg-gradient-to-br from-primary via-primary to-primary-light">
  <div class="mx-auto max-w-7xl px-4 pt-[calc(var(--nav-height)+3rem)] pb-12 sm:px-6 lg:px-8" data-reveal>
    <span class="text-xs font-bold uppercase tracking-[0.15em] text-silver">{eyebrow}</span>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-white/80">{lead}</p>}
  </div>
</section>
