---
interface Props {
  title?: string;
  text?: string;
}

const { title = 'Service Area Map', text = 'Google Maps — Orlando, FL service area' } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-line shadow-sm" data-reveal="scale">
  <iframe
    title={title}
    src="https://maps.google.com/maps?q=Orlando,%20FL&t=&z=11&ie=UTF8&iwloc=&output=embed"
    class="aspect-[4/3] w-full"
    style="border: 0;"
    loading="lazy"
    allowfullscreen
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  <p class="sr-only">{text}</p>
</div>
