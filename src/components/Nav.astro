---
import Logo from './Logo.astro';
import { link } from '../lib/site';

const current = Astro.url.pathname;
function normalize(p: string): string {
  if (p.length > 1 && p.endsWith('/')) return p.slice(0, -1);
  return p;
}
function isActive(path: string): boolean {
  return normalize(current) === normalize(link(path));
}
function linkCls(path: string): string {
  const base = 'rounded-md px-4 py-2 text-lg font-semibold transition-colors';
  return isActive(path)
    ? `${base} text-primary bg-silver-light`
    : `${base} text-ink hover:text-primary hover:bg-bg-alt`;
}

const links = [
  { path: '/', label: 'Home' },
  { path: '/about/', label: 'About' },
  { path: '/services/', label: 'Services' },
  { path: '/contact/', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 h-[var(--nav-height)] border-b border-line bg-white/90 backdrop-blur-md">
  <nav class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="ml-4 sm:ml-6">
      <Logo />
    </div>

    <div class="hidden items-center gap-2 md:flex">
      {links.map((l) => (
        <a href={link(l.path)} class={linkCls(l.path)} aria-current={isActive(l.path) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md text-ink hover:bg-bg-alt md:hidden"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="nav-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="nav-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-white px-4 pb-6 pt-2 md:hidden">
    <div class="flex flex-col gap-1">
      {links.map((l) => (
        <a href={link(l.path)} class={linkCls(l.path)} aria-current={isActive(l.path) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden', expanded);
    iconOpen?.classList.toggle('hidden', !expanded);
    iconClose?.classList.toggle('hidden', expanded);
    document.body.style.overflow = expanded ? '' : 'hidden';
  });
</script>
