---
import ServicesCarousel from './ServicesCarousel.astro';

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="flex min-h-[100svh] flex-col bg-hero pt-10">
  <div class="mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8" data-reveal>
    <h1 class="mx-auto max-w-5xl text-5xl font-bold uppercase leading-[0.95] tracking-tight text-[#f5efe2] sm:text-7xl lg:text-8xl">
      {title}
    </h1>
    <p class="mt-4 text-xs font-bold uppercase tracking-[0.25em] text-white/70 sm:text-sm">
      {subtitle}
    </p>
  </div>

  <div class="mt-10" data-reveal>
    <ServicesCarousel />
  </div>
</section>
