---
import ServicesCarousel from './ServicesCarousel.astro';
import Button from './Button.astro';
import { link } from '../lib/site';

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="flex min-h-[100svh] flex-col bg-hero pt-10">
  <div class="mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8" data-reveal>
    <h1 class="mx-auto max-w-5xl text-5xl font-bold uppercase leading-[0.95] tracking-tight text-ink sm:text-7xl lg:text-8xl">
      {title}
    </h1>
    <p class="mt-4 text-xs font-bold uppercase tracking-[0.25em] text-muted sm:text-sm">
      {subtitle}
    </p>
  </div>

  <div class="mx-auto mt-10 w-full max-w-3xl px-4 sm:px-6" data-reveal>
    <div class="rounded-2xl border border-line bg-[#fffdf8] p-6 text-center shadow-sm sm:p-8">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Get Started</span>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Let's Work Together</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg leading-relaxed text-muted">
        One request away from spotless — tell us about the job and get a detailed estimate within hours.
      </p>
      <div class="mt-6 flex flex-col justify-center gap-3 border-t border-line pt-6 sm:flex-row">
        <Button href={link('/quote/')} variant="primary" size="lg">Request a Free Quote</Button>
        <Button href={link('/contact/')} variant="outline" size="lg">Get in Touch</Button>
      </div>
    </div>
  </div>

  <div class="mt-10">
    <ServicesCarousel />
  </div>
</section>
