---
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  imageSrc: string;
  imageAlt: string;
}

const {
  eyebrow,
  title,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  imageSrc,
  imageAlt,
} = Astro.props;
---

<section class="relative flex min-h-[92vh] items-center overflow-hidden bg-primary">
  <div class="absolute inset-0">
    <img
      src={imageSrc}
      alt={imageAlt}
      loading="eager"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-primary/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-primary/30"></div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-4 pt-[calc(var(--nav-height)+3rem)] pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center" data-reveal>
      <span class="inline-flex items-center rounded-full bg-white/10 px-5 py-2 text-sm font-bold uppercase tracking-[0.15em] text-white ring-1 ring-white/25">
        {eyebrow}
      </span>
      <h1 class="mx-auto mt-5 max-w-4xl text-center text-6xl font-bold leading-tight tracking-tight text-white sm:text-7xl lg:text-8xl">
        {title}
      </h1>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <Button href={primaryHref} variant="primary" size="lg">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="secondary" size="lg">{secondaryLabel}</Button>
      </div>
    </div>
  </div>
</section>
