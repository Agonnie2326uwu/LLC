---
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  imageSrc: string;
  imageAlt: string;
}

const {
  eyebrow,
  title,
  subtitle,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  imageSrc,
  imageAlt,
} = Astro.props;
---

<section class="relative flex min-h-[92vh] items-center overflow-hidden bg-primary">
  <div class="absolute inset-0">
    <img
      src={imageSrc}
      alt={imageAlt}
      loading="eager"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/95 via-primary/80 to-primary/40"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary/70 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-4 pt-[calc(var(--nav-height)+3rem)] pb-16 sm:px-6 lg:px-8">
    <div class="max-w-2xl" data-reveal>
      <span class="inline-flex items-center rounded-full bg-white/10 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.15em] text-white ring-1 ring-white/25">
        {eyebrow}
      </span>
      <h1 class="mt-5 text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        {title}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">
        {subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href={primaryHref} variant="primary">{primaryLabel}</Button>
        <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
      </div>
    </div>
  </div>
</section>
