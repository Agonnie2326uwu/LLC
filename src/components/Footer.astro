---
import { SITE_NAME, PHONE_DISPLAY, PHONE_HREF, EMAIL, AREA, INSTAGRAM, link } from '../lib/site';

const services = [
  { anchor: '#construction', label: 'Pre & Post-Construction' },
  { anchor: '#commercial', label: 'Commercial Cleaning' },
  { anchor: '#residential', label: 'Residential Cleaning' },
  { anchor: '#airbnb', label: 'Airbnb / Vacation Rental' },
  { anchor: '#movein', label: 'Move-In / Move-Out' },
  { anchor: '#deep', label: 'Deep Cleaning' },
];
---

<footer class="bg-footer text-white">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-white font-bold text-primary">LD</span>
          <span class="font-bold tracking-tight">Luxury Duo Cleaning</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-white/70">
          Precision cleaning for contractors, commercial properties, and homeowners across the Orlando area.
        </p>
      </div>

      <nav aria-label="Services">
        <h3 class="text-sm font-bold uppercase tracking-[0.12em] text-white/60">Services</h3>
        <ul class="mt-4 space-y-2.5">
          {services.map((s) => (
            <li>
              <a href={`${link('/services/')}${s.anchor}`} class="text-sm text-white/85 hover:text-white hover:underline">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Company">
        <h3 class="text-sm font-bold uppercase tracking-[0.12em] text-white/60">Company</h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href={link('/about/')} class="text-sm text-white/85 hover:text-white hover:underline">About Us</a></li>
          <li><a href={link('/contact/')} class="text-sm text-white/85 hover:text-white hover:underline">Contact</a></li>
          <li><a href={link('/quote/')} class="text-sm text-white/85 hover:text-white hover:underline">Get a Quote</a></li>
        </ul>
      </nav>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-[0.12em] text-white/60">Contact</h3>
        <ul class="mt-4 space-y-3 text-sm text-white/85">
          <li class="flex items-center gap-2.5">
            <svg class="h-4 w-4 shrink-0 text-silver" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
            </svg>
            <a href={PHONE_HREF} class="hover:text-white hover:underline">{PHONE_DISPLAY}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="h-4 w-4 shrink-0 text-silver" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <a href={`mailto:${EMAIL}`} class="hover:text-white hover:underline">{EMAIL}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="h-4 w-4 shrink-0 text-silver" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>{AREA}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 sm:flex-row">
      <span class="text-sm text-white/60">&copy; 2026 {SITE_NAME}. All rights reserved.</span>
      <a href={INSTAGRAM} aria-label="Instagram" class="inline-flex h-9 w-9 items-center justify-center rounded-full text-white/80 ring-1 ring-white/20 hover:bg-white/10 hover:text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
          <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" />
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
        </svg>
      </a>
    </div>
  </div>
</footer>
