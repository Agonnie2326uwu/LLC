---
import { Picture } from 'astro:assets';
import { SERVICES } from '../lib/services.ts';
import { resolveImage, cropSet, PICTURE_FORMATS } from '../lib/images.ts';

const base = import.meta.env.BASE_URL;
const COUNT = SERVICES.length;

const btn =
  'inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line bg-white text-ink shadow-sm transition hover:bg-silver-light';
---

<div
  data-carousel="round"
  data-count={String(COUNT)}
  data-autoplay="4000"
  role="region"
  aria-roledescription="carousel"
  aria-label="Our cleaning services"
  class="flex items-center gap-2 sm:gap-4"
>
  <button type="button" data-prev data-js-only aria-label="Previous service" class={`invisible ${btn}`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
  </button>

  <div class="min-w-0 flex-1">
    <div data-viewport class="select-none">
      <div data-track class="flex items-stretch gap-6 will-change-transform">
        {SERVICES.map((service, i) => (
          <article
            data-slide={String(i)}
            data-title={service.title}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${COUNT}`}
            class="flex w-56 shrink-0 flex-col items-center gap-3 rounded-xl border border-line bg-white p-4 text-center shadow-sm sm:w-72"
          >
            {(() => {
              const cls = 'pointer-events-none aspect-square h-32 w-32 rounded-full object-cover sm:h-44 sm:w-44';
              const meta = resolveImage(service.image);
              if (!meta) {
                return (
                  <img
                    src={`${base}${service.image}`}
                    alt={service.imageAlt}
                    loading="lazy"
                    decoding="async"
                    width="288"
                    height="288"
                    draggable="false"
                    class={cls}
                  />
                );
              }
              // Circles are 128px (176px at sm+); 400px square covers 2x+ DPR
              const crop = cropSet(meta, 1, [200, 400]);
              return (
                <Picture
                  src={meta}
                  alt={service.imageAlt}
                  formats={[...PICTURE_FORMATS]}
                  fallbackFormat="jpg"
                  width={400}
                  height={400}
                  widths={crop.widths.filter((w) => w <= 400)}
                  sizes="(min-width: 640px) 176px, 128px"
                  fit="cover"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class={cls}
                  pictureAttributes={{ class: 'contents' }}
                />
              );
            })()}
            <h3 class="text-sm font-bold text-ink sm:text-base">{service.title}</h3>
            <a
              href={`${base}services/#${service.slug}`}
              draggable="false"
              class="inline-flex items-center gap-1 text-sm font-semibold text-accent hover:text-accent-hover hover:underline"
            >
              Learn more <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div data-js-only class="invisible mt-6 flex items-center justify-center gap-1">
      <button
        type="button"
        data-toggle
        aria-label="Pause automatic slide show"
        data-state="playing"
        class="mr-2 inline-flex h-11 w-11 items-center justify-center rounded-full text-ink transition hover:bg-silver-light"
      >
        <svg data-icon-pause aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
        <svg data-icon-play aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
      </button>
      {SERVICES.map((service, i) => (
        <button
          type="button"
          data-dot={String(i)}
          aria-label={`Show ${service.title}`}
          aria-current={i === 0 ? 'true' : undefined}
          class="inline-flex h-6 min-w-6 items-center justify-center rounded-full"
        >
          <span class="dot-mark block h-2.5 w-2.5 rounded-full bg-muted"></span>
        </button>
      ))}
    </div>
    <p data-status class="sr-only" aria-live="polite" aria-atomic="true"></p>
  </div>

  <button type="button" data-next data-js-only aria-label="Next service" class={`invisible ${btn}`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
  </button>
</div>

<script>
  import { registerStrips } from '../scripts/strip.ts';
  registerStrips('[data-carousel="round"]');
</script>

<style>
  /* Pre-init / no-JS: a native swipeable row showing card 1 first */
  [data-carousel="round"] [data-viewport] {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  [data-carousel="round"] [data-viewport]::-webkit-scrollbar {
    display: none;
  }
  [data-carousel="round"] [data-slide] {
    scroll-snap-align: start;
  }
  /* Engine running: clipped strip, vertical page scroll stays native */
  [data-carousel="round"][data-ready] [data-viewport] {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
    cursor: grab;
  }
  [data-carousel="round"][data-ready] [data-viewport]:active {
    cursor: grabbing;
  }
  [data-carousel="round"] [data-track] {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-carousel="round"] [data-track].no-anim {
    transition: none !important;
  }
  /* Dots: inactive = small muted dot (5:1 on cream), active = wide charcoal pill */
  [data-carousel="round"] .dot-mark {
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  [data-carousel="round"] [data-dot][aria-current="true"] .dot-mark {
    width: 1.5rem;
    background-color: var(--color-primary);
  }
  [data-carousel="round"] [data-dot]:hover:not([aria-current="true"]) .dot-mark {
    background-color: var(--color-primary-light);
  }
  [data-carousel="round"] [data-toggle][data-state="playing"] [data-icon-play],
  [data-carousel="round"] [data-toggle][data-state="paused"] [data-icon-pause] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-carousel="round"] [data-track],
    [data-carousel="round"] .dot-mark {
      transition: none !important;
    }
  }
</style>
