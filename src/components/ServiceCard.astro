---
interface Props {
  title: string;
  desc: string;
  href: string;
  imageSrc: string;
  imageAlt: string;
  flagship?: boolean;
  delay?: number;
  hideDesc?: boolean;
  center?: boolean;
}

const { title, href, imageSrc, imageAlt, flagship = false, delay = 0, center = false } = Astro.props;
---

<article
  data-reveal
  style={`transition-delay: ${delay}ms`}
  class={`group relative flex-1 overflow-hidden rounded-2xl shadow-sm transition-all duration-500 hover:-translate-y-1.5 hover:shadow-xl ${center ? 'min-h-[24rem] md:min-h-[30rem]' : 'min-h-[20rem] md:min-h-[24rem] md:mt-14'} ${flagship ? 'ring-2 ring-accent ring-offset-2 ring-offset-bg-alt' : ''}`}
>
  {flagship && (
    <span class="absolute left-4 top-4 z-10 inline-flex items-center rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">
      Most Requested
    </span>
  )}
  <img
    src={imageSrc}
    alt={imageAlt}
    loading="lazy"
    width="600"
    height="800"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 flex flex-col p-6">
    <h3 class="text-2xl font-bold text-white">{title}</h3>
    <a href={href} class="mt-2 inline-flex items-center gap-1 self-start font-semibold text-white/90 hover:text-white hover:underline">
      Learn more <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
