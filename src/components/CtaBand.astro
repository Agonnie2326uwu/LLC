---
import Button from './Button.astro';

interface Props {
  title: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
}

const { title, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="bg-footer">
  <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6" data-reveal>
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href={primaryHref} variant="primary">{primaryLabel}</Button>
      <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
    </div>
  </div>
</section>
