---
import { TESTIMONIALS } from '../lib/testimonials.ts';
import TestimonialCard from './TestimonialCard.astro';

const PER_GROUP = 3;
const groups: (typeof TESTIMONIALS)[] = [];
for (let i = 0; i < TESTIMONIALS.length; i += PER_GROUP) {
  groups.push(TESTIMONIALS.slice(i, i + PER_GROUP));
}
const total = TESTIMONIALS.length;
const rangeLabel = (gi: number) => {
  const start = gi * PER_GROUP + 1;
  const end = Math.min(start + PER_GROUP - 1, total);
  return `${start}–${end}`;
};

const arrowBtn =
  'flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-line bg-white text-primary shadow-sm transition hover:bg-silver-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<div
  data-carousel="testimonials"
  role="region"
  aria-roledescription="carousel"
  aria-label="Client reviews"
>
  <div class="min-w-0">
    {groups.map((group, gi) => (
      <div
        data-group={String(gi)}
        data-range={rangeLabel(gi)}
        role="group"
        aria-roledescription="slide"
        aria-label={`Reviews ${rangeLabel(gi)} of ${total}`}
        hidden={gi !== 0}
        class="grid gap-6 md:grid-cols-3"
      >
        {group.map((t) => (
          <TestimonialCard quote={t.quote} name={t.name} role={t.role} initials={t.initials} />
        ))}
      </div>
    ))}
  </div>

  {groups.length > 1 && (
    <div class="mt-8 flex items-center justify-center gap-4">
      <button type="button" data-prev aria-label="Previous reviews" class={arrowBtn}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>

      <div class="flex items-center gap-1">
        {groups.map((_, gi) => (
          <button
            type="button"
            data-dot={String(gi)}
            aria-label={`Show reviews ${rangeLabel(gi)}`}
            aria-current={gi === 0 ? 'true' : undefined}
            class="group flex h-8 w-8 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-accent"
          >
            <span
              data-dot-mark
              class={`block h-3 rounded-full transition-all ${gi === 0 ? 'w-6 bg-primary' : 'w-3 bg-primary/30 group-hover:bg-primary/60'}`}
            />
          </button>
        ))}
      </div>

      <button type="button" data-next aria-label="Next reviews" class={arrowBtn}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    </div>
  )}
  <p data-status class="sr-only" aria-live="polite"></p>
</div>

<script>
  let cleanups: Array<() => void> = [];

  function initTestimonials() {
    cleanups.forEach((fn) => fn());
    cleanups = [];

    document.querySelectorAll<HTMLElement>('[data-carousel="testimonials"]').forEach((root) => {
      const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-group]'));
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      const status = root.querySelector<HTMLElement>('[data-status]');
      const total = groups.length;
      if (total < 2) return;
      let index = 0;

      const show = (i: number, announce = true) => {
        index = ((i % total) + total) % total;
        groups.forEach((g, gi) => (g.hidden = gi !== index));
        dots.forEach((d, di) => {
          const active = di === index;
          if (active) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
          const mark = d.querySelector('[data-dot-mark]');
          mark?.classList.toggle('w-6', active);
          mark?.classList.toggle('bg-primary', active);
          mark?.classList.toggle('w-3', !active);
          mark?.classList.toggle('bg-primary/30', !active);
          mark?.classList.toggle('group-hover:bg-primary/60', !active);
        });
        if (status && announce) {
          status.textContent = `Showing reviews ${groups[index].dataset.range} of ${root.querySelectorAll('figure').length}`;
        }
      };

      const onPrev = () => show(index - 1);
      const onNext = () => show(index + 1);
      const dotHandlers = dots.map((d, di) => {
        const h = () => show(di);
        d.addEventListener('click', h);
        return h;
      });
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') onPrev();
        else if (e.key === 'ArrowRight') onNext();
      };

      prev?.addEventListener('click', onPrev);
      next?.addEventListener('click', onNext);
      root.addEventListener('keydown', onKey);
      show(0, false);

      cleanups.push(() => {
        prev?.removeEventListener('click', onPrev);
        next?.removeEventListener('click', onNext);
        root.removeEventListener('keydown', onKey);
        dots.forEach((d, di) => d.removeEventListener('click', dotHandlers[di]));
      });
    });
  }

  document.addEventListener('astro:page-load', initTestimonials);
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>
