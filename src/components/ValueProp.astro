---
interface Props {
  icon: 'detail' | 'clock' | 'shield' | 'bolt';
  title: string;
  text: string;
}

const { icon, title, text } = Astro.props;
---

<div data-reveal class="flex items-start gap-4 rounded-xl border border-line bg-white p-6 shadow-sm">
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-bg-alt text-accent" aria-hidden="true">
    {icon === 'detail' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    )}
    {icon === 'clock' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 16 14" />
      </svg>
    )}
    {icon === 'shield' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      </svg>
    )}
    {icon === 'bolt' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
      </svg>
    )}
  </span>
  <span>
    <span class="block text-lg font-bold text-ink">{title}</span>
    <span class="block text-muted">{text}</span>
  </span>
</div>
