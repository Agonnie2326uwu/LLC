---
import { SERVICES, FLAGSHIP_SLUG } from '../lib/services.ts';
import ServiceCard from './ServiceCard.astro';

const base = import.meta.env.BASE_URL;
const groups = [SERVICES.slice(0, 3), SERVICES.slice(3, 6)];

// Home-only photo overrides (services page keeps the shared images from services.ts)
const HOME_IMAGES: Record<string, { image: string; imageAlt: string }> = {
  construction: {
    image: 'images/services/home-construction.jpg',
    imageAlt: 'Crew in hard hats detailing windows and floors — post-construction cleaning in Orlando FL',
  },
  commercial: {
    image: 'images/services/home-commercial.jpg',
    imageAlt: 'Cleaning team vacuuming and mopping an office — commercial cleaning in Orlando FL',
  },
  residential: {
    image: 'images/services/home-residential.jpg',
    imageAlt: 'Broom sweeping a wood floor — residential cleaning in Orlando FL',
  },
  airbnb: {
    image: 'images/services/home-airbnb.jpg',
    imageAlt: 'Cleaner carrying a caddy of spray bottles — Airbnb turnover cleaning in Orlando FL',
  },
  movein: {
    image: 'images/services/home-movein.jpg',
    imageAlt: 'Moving boxes with a broom ready — move-in move-out cleaning in Orlando FL',
  },
  deep: {
    image: 'images/services/home-deep.jpg',
    imageAlt: 'Hands in yellow rubber gloves with spray bottle and sponge — deep cleaning in Orlando FL',
  },
};
---

<div data-carousel="services" class="flex items-stretch gap-2 sm:gap-4">
  <button
    type="button"
    data-prev
    aria-label="Previous services"
    class="my-auto flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line bg-white text-xl text-primary shadow-sm transition hover:bg-bg-alt focus-visible:outline-accent"
  >
    <span aria-hidden="true">←</span>
  </button>

  <div class="min-w-0 flex-1">
    {groups.map((group, gi) => (
      <div data-group={String(gi)} hidden={gi !== 0} class="grid gap-6 md:grid-cols-3">
        {group.map((service, i) => (
          <ServiceCard
            title={service.title}
            desc={service.desc}
            href={`${base}services/#${service.slug}`}
            imageSrc={`${base}${HOME_IMAGES[service.slug]?.image ?? service.image}`}
            imageAlt={HOME_IMAGES[service.slug]?.imageAlt ?? service.imageAlt}
            flagship={service.slug === FLAGSHIP_SLUG}
            delay={(gi * 3 + i) * 100}
            hideDesc
          />
        ))}
      </div>
    ))}

    <div class="mt-6 flex items-center justify-center gap-2">
      {groups.map((_, gi) => (
        <button
          type="button"
          data-dot={String(gi)}
          aria-label={gi === 0 ? 'Show services 1-3' : 'Show services 4-6'}
          aria-current={gi === 0 ? 'true' : undefined}
          class={`h-3 w-3 rounded-full transition ${gi === 0 ? 'bg-primary' : 'bg-line hover:bg-silver'}`}
        />
      ))}
    </div>
    <p data-status class="sr-only" aria-live="polite">Showing services 1–3 of 6</p>
  </div>

  <button
    type="button"
    data-next
    aria-label="Next services"
    class="my-auto flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line bg-white text-xl text-primary shadow-sm transition hover:bg-bg-alt focus-visible:outline-accent"
  >
    <span aria-hidden="true">→</span>
  </button>
</div>

<script>
  const roots = document.querySelectorAll('[data-carousel="services"]');
  roots.forEach((root) => {
    const groups = Array.from(root.querySelectorAll('[data-group]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const status = root.querySelector('[data-status]');
    const total = groups.length;
    let index = 0;

    const labels = ['Showing services 1–3 of 6', 'Showing services 4–6 of 6'];

    function show(i) {
      index = ((i % total) + total) % total;
      groups.forEach((g, gi) => {
        if (gi === index) g.removeAttribute('hidden');
        else g.setAttribute('hidden', '');
      });
      dots.forEach((d, di) => {
        const active = di === index;
        if (active) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
        d.classList.toggle('bg-primary', active);
        d.classList.toggle('bg-line', !active);
      });
      if (status) status.textContent = labels[index] ?? `Showing group ${index + 1} of ${total}`;
    }

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((d, di) => d.addEventListener('click', () => show(di)));
    show(0);
  });
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-carousel="services"] [data-group] {
      transition: none !important;
    }
  }
</style>
