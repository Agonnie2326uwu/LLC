---
import { Picture } from 'astro:assets';
import { SERVICES, FLAGSHIP_SLUG } from '../lib/services.ts';
import { resolveImage, cropSet, PICTURE_FORMATS } from '../lib/images.ts';

const base = import.meta.env.BASE_URL;

// Slides are 3:4 portrait, up to ~576×768 CSS px (h: 55vh mobile / 80vh sm+, capped 20–48rem)
const SLIDE_SIZES = '(min-width: 640px) clamp(240px, 60vh, 576px), clamp(240px, 41.25vh, 576px)';

// Home-only photo overrides (services page keeps the shared images from services.ts)
const HOME_IMAGES: Record<string, { image: string; imageAlt: string }> = {
  construction: {
    image: 'images/services/home-construction.webp',
    imageAlt: 'Crew in hard hats detailing windows and floors — post-construction cleaning in Orlando FL',
  },
  commercial: {
    image: 'images/services/home-commercial.webp',
    imageAlt: 'Cleaning team vacuuming and mopping an office — commercial cleaning in Orlando FL',
  },
  residential: {
    image: 'images/services/home-residential.webp',
    imageAlt: 'Broom sweeping a wood floor — residential cleaning in Orlando FL',
  },
  airbnb: {
    image: 'images/services/home-airbnb.webp',
    imageAlt: 'Cleaner carrying a caddy of spray bottles — Airbnb turnover cleaning in Orlando FL',
  },
  movein: {
    image: 'images/services/home-movein.webp',
    imageAlt: 'Moving boxes with a broom ready — move-in move-out cleaning in Orlando FL',
  },
  deep: {
    image: 'images/services/home-deep.webp',
    imageAlt: 'Hands in yellow rubber gloves with spray bottle and sponge — deep cleaning in Orlando FL',
  },
};

const COUNT = SERVICES.length;

const btn =
  'inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-white text-ink shadow-sm transition hover:bg-silver-light';
---

<div
  data-carousel="services"
  data-count={String(COUNT)}
  data-drift="30"
  role="region"
  aria-roledescription="carousel"
  aria-label="Our cleaning services"
>
  <div
    data-viewport
    class="relative left-1/2 mt-6 h-[55vh] max-h-[48rem] min-h-[20rem] w-screen -translate-x-1/2 select-none sm:h-[80vh]"
  >
    <div data-track class="flex h-full gap-2 will-change-transform">
      {SERVICES.map((service, i) => (
        <article
          data-slide={String(i)}
          data-title={service.title}
          data-dark
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${COUNT}`}
          class="panel group relative aspect-[3/4] h-full shrink-0 overflow-hidden"
        >
          {(() => {
            const path = HOME_IMAGES[service.slug]?.image ?? service.image;
            const alt = HOME_IMAGES[service.slug]?.imageAlt ?? service.imageAlt;
            const cls = 'pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105';
            const meta = resolveImage(path);
            if (!meta) {
              return (
                <img
                  src={`${base}${path}`}
                  alt={alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  width="800"
                  height="1000"
                  draggable="false"
                  class={cls}
                />
              );
            }
            const crop = cropSet(meta, 3 / 4, [320, 480, 640, 800]);
            return (
              <Picture
                src={meta}
                alt={alt}
                formats={[...PICTURE_FORMATS]}
                fallbackFormat="jpg"
                width={crop.width}
                height={crop.height}
                widths={crop.widths}
                sizes={SLIDE_SIZES}
                fit="cover"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
                draggable="false"
                class={cls}
                pictureAttributes={{ class: 'contents' }}
              />
            );
          })()}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
          {service.slug === FLAGSHIP_SLUG && (
            <span class="absolute left-4 top-4 z-10 inline-flex items-center rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">
              Most Requested
            </span>
          )}
          <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
            <h3 class="flex min-h-[2.4em] items-end text-2xl font-bold leading-tight text-white sm:text-3xl">{service.title}</h3>
            <a
              href={`${base}services/#${service.slug}`}
              draggable="false"
              data-dark
              class="mt-2 inline-flex items-center gap-1 text-lg font-semibold text-white/90 hover:text-white hover:underline"
            >
              Learn more <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div data-js-only class="invisible mt-6 flex items-center justify-center gap-4 pb-10 sm:mt-8 sm:pb-14">
    <button type="button" data-prev aria-label="Previous service" class={btn}>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <button type="button" data-toggle aria-label="Pause automatic slide show" data-state="playing" class={btn}>
      <svg data-icon-pause aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
      <svg data-icon-play aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
    </button>
    <button type="button" data-next aria-label="Next service" class={btn}>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
    </button>
  </div>

  <p data-status class="sr-only" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import { registerStrips } from '../scripts/strip.ts';
  registerStrips('[data-carousel="services"]');
</script>

<style>
  /* Pre-init / no-JS: a native swipeable row showing slide 1 first */
  [data-carousel="services"] [data-viewport] {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  [data-carousel="services"] [data-viewport]::-webkit-scrollbar {
    display: none;
  }
  [data-carousel="services"] [data-slide] {
    scroll-snap-align: start;
  }
  /* Engine running: clipped strip, vertical page scroll stays native */
  [data-carousel="services"][data-ready] [data-viewport] {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
    cursor: grab;
  }
  [data-carousel="services"][data-ready] [data-viewport]:active {
    cursor: grabbing;
  }
  [data-carousel="services"] [data-track] {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-carousel="services"] [data-track].no-anim {
    transition: none !important;
  }
  [data-carousel="services"] [data-track].dragging img {
    transform: none !important;
  }
  [data-carousel="services"] [data-toggle][data-state="playing"] [data-icon-play],
  [data-carousel="services"] [data-toggle][data-state="paused"] [data-icon-pause] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-carousel="services"] [data-track] {
      transition: none !important;
    }
  }
</style>
