---
import { SERVICES, FLAGSHIP_SLUG } from '../lib/services.ts';

const base = import.meta.env.BASE_URL;

// Home-only photo overrides (services page keeps the shared images from services.ts)
const HOME_IMAGES: Record<string, { image: string; imageAlt: string }> = {
  construction: {
    image: 'images/services/home-construction.jpg',
    imageAlt: 'Crew in hard hats detailing windows and floors — post-construction cleaning in Orlando FL',
  },
  commercial: {
    image: 'images/services/home-commercial.jpg',
    imageAlt: 'Cleaning team vacuuming and mopping an office — commercial cleaning in Orlando FL',
  },
  residential: {
    image: 'images/services/home-residential.jpg',
    imageAlt: 'Broom sweeping a wood floor — residential cleaning in Orlando FL',
  },
  airbnb: {
    image: 'images/services/home-airbnb.jpg',
    imageAlt: 'Cleaner carrying a caddy of spray bottles — Airbnb turnover cleaning in Orlando FL',
  },
  movein: {
    image: 'images/services/home-movein.jpg',
    imageAlt: 'Moving boxes with a broom ready — move-in move-out cleaning in Orlando FL',
  },
  deep: {
    image: 'images/services/home-deep.jpg',
    imageAlt: 'Hands in yellow rubber gloves with spray bottle and sponge — deep cleaning in Orlando FL',
  },
};

// Infinite loop: clones of the last 3 up front, first 3 at the end
const LOOP = [
  ...SERVICES.slice(-3).map((service) => ({ service, clone: true })),
  ...SERVICES.map((service) => ({ service, clone: false })),
  ...SERVICES.slice(0, 3).map((service) => ({ service, clone: true })),
];
const COUNT = SERVICES.length;
const LEAD = 3;

---

<div data-carousel="services">
  <div
    data-viewport
    class="relative left-1/2 mt-6 h-[55vh] max-h-[48rem] min-h-[20rem] w-screen -translate-x-1/2 cursor-grab touch-pan-y select-none overflow-hidden sm:h-[80vh]"
  >
    <div data-track class="flex h-full gap-2 will-change-transform">
      {LOOP.map(({ service, clone }, i) => (
        <article
          data-slide={String(i)}
          data-clone={clone ? 'true' : 'false'}
          aria-hidden={clone ? 'true' : undefined}
          class="panel group relative aspect-[3/4] h-full shrink-0 overflow-hidden"
        >
          <img
            src={`${base}${HOME_IMAGES[service.slug]?.image ?? service.image}`}
            alt={clone ? '' : (HOME_IMAGES[service.slug]?.imageAlt ?? service.imageAlt)}
            loading="eager"
            decoding="async"
            fetchpriority={!clone && i < LEAD + 3 ? 'high' : 'auto'}
            width="800"
            height="1000"
            draggable="false"
            class="pointer-events-none absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
          {service.slug === FLAGSHIP_SLUG && (
            <span class="absolute left-4 top-4 z-10 inline-flex items-center rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-widest text-white">
              Most Requested
            </span>
          )}
          <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
            <h3 class="flex min-h-[2.4em] items-end text-2xl font-bold leading-tight text-white sm:text-3xl">{service.title}</h3>
            <a
              href={`${base}services/#${service.slug}`}
              tabindex={clone ? '-1' : undefined}
              class="mt-2 inline-flex items-center gap-1 text-lg font-semibold text-white/90 hover:text-white hover:underline"
            >
              Learn more <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  <p data-status class="sr-only" aria-live="polite">Showing service 1 of 6</p>
</div>

<script>
  const roots = document.querySelectorAll('[data-carousel="services"]');
  roots.forEach((root) => {
    const viewport = root.querySelector('[data-viewport]');
    const track = root.querySelector('[data-track]');
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const status = root.querySelector('[data-status]');
    const total = slides.length;
    const count = total > 6 ? 6 : total;
    const lead = Math.floor((total - count) / 2) || 0;
    let pos = lead;

    function step() {
      return cachedStep;
    }

    function measure() {
      const first = slides[0];
      const second = slides[1];
      const gap = second ? second.offsetLeft - (first.offsetLeft + first.offsetWidth) : 8;
      cachedStep = first ? first.offsetWidth + gap : 0;
    }
    let cachedStep = 0;

    function logical() {
      return ((pos - lead) % count + count) % count;
    }

    function place(animate = true) {
      if (!track) return;
      track.classList.toggle('no-anim', !animate);
      track.style.transform = `translateX(${-pos * step()}px)`;
      if (status) status.textContent = `Showing service ${logical() + 1} of ${count}`;
    }

    function settle() {
      // Seamless wrap: jump back into the real range with animation off
      if (pos < lead || pos >= lead + count) {
        pos = lead + logical();
        place(false);
      }
    }

    function advance(dir, animate = true) {
      pos += dir;
      place(animate);
      clearTimeout(advance._t);
      advance._t = setTimeout(settle, 650);
    }

    // Drag / swipe to scroll the strip — never ending in both directions,
    // with momentum glide on fast flings.
    let startX = null;
    let baseX = 0;
    let dragging = false;
    let movedX = 0;
    let lastX = 0;
    let samples = [];
    let glideId = null;
    let suppressClick = false;
    let captured = false;
    const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function stopGlide() {
      if (glideId) cancelAnimationFrame(glideId);
      glideId = null;
    }
    function holdRest() {
      // Release: stay EXACTLY where dropped — no snap, no correction.
      // Only sync bookkeeping (nearest panel + screen-reader status).
      stopGlide();
      track?.classList.remove('no-anim');
      track?.classList.remove('dragging');
      if (status) status.textContent = `Showing service ${logical() + 1} of ${count}`;
      restart();
    }
    function flickVelocity() {
      const now = performance.now();
      const recent = samples.filter((s) => now - s.t < 120);
      if (recent.length < 2) return 0;
      const a = recent[0];
      const b = recent[recent.length - 1];
      const dt = b.t - a.t;
      if (dt <= 0) return 0;
      return ((b.x - a.x) / dt) * 0.9;
    }
    function startGlide(v0) {
      stopGlide();
      const st = step();
      if (!st || !track) {
        holdRest();
        return;
      }
      let v = Math.max(-8, Math.min(8, v0));
      let x = lastX;
      let last = performance.now();
      const span = count * st;
      const lo = -(lead + count) * st;
      const hi = -lead * st;
      const frame = (now) => {
        const dt = Math.min(50, now - last);
        last = now;
        v *= Math.pow(0.95, dt / 16.7);
        x += v * dt;
        while (x < lo) x += span;
        while (x > hi) x -= span;
        pos = Math.round(-x / st);
        track.style.transform = `translateX(${x}px)`;
        lastX = x;
        if (Math.abs(v) > 0.08) {
          glideId = requestAnimationFrame(frame);
        } else {
          glideId = null;
          holdRest();
        }
      };
      glideId = requestAnimationFrame(frame);
    }
    viewport?.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      dragging = true;
      movedX = 0;
      captured = false;
      samples = [{ x: e.clientX, t: performance.now() }];
      stopGlide();
      measure();
      baseX = lastX;
      lastX = baseX;
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    });
    viewport?.addEventListener('pointermove', (e) => {
      if (!dragging || startX === null || !track) return;
      const dx = e.clientX - startX;
      movedX = dx;
      if (!captured && Math.abs(dx) <= 5) return;
      if (!captured) {
        captured = true;
        track?.classList.add('no-anim');
        track?.classList.add('dragging');
        try {
          viewport.setPointerCapture?.(e.pointerId);
        } catch {
          /* ignore */
        }
      }
      samples.push({ x: e.clientX, t: performance.now() });
      if (samples.length > 8) samples.shift();
      const st = step();
      if (!st) return;
      const span = count * st;
      let x = baseX + dx * 0.9;
      const lo = -(lead + count) * st;
      const hi = -lead * st;
      while (x < lo) x += span;
      while (x > hi) x -= span;
      pos = Math.round(-x / st);
      lastX = x;
      track.style.transform = `translateX(${x}px)`;
    });
    function endDrag(e) {
      if (!dragging || startX === null) return;
      dragging = false;
      startX = null;
      if (captured) {
        captured = false;
        try {
          if (viewport?.hasPointerCapture?.(e.pointerId)) viewport.releasePointerCapture(e.pointerId);
        } catch {
          /* ignore */
        }
      } else {
        // Pure tap: never hijacked — let the click (e.g. Learn more) through untouched.
        suppressClick = false;
        restart();
        return;
      }
      suppressClick = Math.abs(movedX) > 10;
      const v = flickVelocity();
      if (Math.abs(v) > 0.25 && !reduceMotion()) {
        startGlide(v);
      } else {
        holdRest();
      }
    }
    viewport?.addEventListener('pointerup', endDrag);
    viewport?.addEventListener('pointercancel', endDrag);
    viewport?.addEventListener(
      'click',
      (e) => {
        if (suppressClick) {
          e.preventDefault();
          e.stopPropagation();
          suppressClick = false;
        }
      },
      true,
    );

    // Automatic movement (paused on hover/focus, off for reduced motion)
    let timer = null;
    function restart() {
      if (reduceMotion()) return;
      if (timer) clearInterval(timer);
      timer = setInterval(() => advance(1), 5000);
    }
    root.addEventListener('mouseenter', () => {
      if (timer) clearInterval(timer);
      timer = null;
    });
    root.addEventListener('mouseleave', restart);
    root.addEventListener('focusin', () => {
      if (timer) clearInterval(timer);
      timer = null;
    });
    root.addEventListener('focusout', restart);

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        measure();
        place(false);
        lastX = -pos * step();
      }, 200);
    });

    measure();
    place(false);
    lastX = -pos * step();
    restart();
  });
</script>

<style>
  [data-carousel="services"] [data-track] {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-carousel="services"] [data-track].no-anim {
    transition: none !important;
  }
  [data-carousel="services"] [data-track].dragging img {
    transform: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-carousel="services"] [data-track] {
      transition: none !important;
    }
  }
</style>
