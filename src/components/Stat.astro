---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="text-center" data-reveal>
  <div class="text-4xl font-bold tracking-tight text-primary sm:text-5xl">{value}</div>
  <div class="mt-2 text-sm font-semibold uppercase tracking-wider text-muted">{label}</div>
</div>
