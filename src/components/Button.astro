---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'dark';
  size?: 'md' | 'sm';
  block?: boolean;
}

const { href, variant = 'primary', size = 'md', block = false } = Astro.props;

const base = 'inline-flex items-center justify-center rounded-lg font-bold transition-colors';
const variants: Record<string, string> = {
  primary: 'bg-accent text-white hover:bg-accent-hover',
  secondary: 'bg-white text-primary hover:bg-silver-light border border-white',
  outline: 'border-2 border-primary text-primary bg-transparent hover:bg-primary hover:text-white',
  dark: 'bg-primary text-white hover:bg-primary-light',
};
const sizes: Record<string, string> = {
  md: 'px-6 py-3 text-base',
  sm: 'px-4 py-2 text-sm',
};
const classes = [base, variants[variant], sizes[size], block ? 'w-full' : ''].join(' ');
---

<a href={href} class={classes}>
  <slot />
</a>
